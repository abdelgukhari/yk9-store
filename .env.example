# ---- Database (PostgreSQL) ----
# DB_ENGINE: "postgresql" (default) or "sqlite3" (native local dev only)
DB_ENGINE=postgresql
POSTGRES_DB=yk9
POSTGRES_USER=yk9
POSTGRES_PASSWORD=yk9
POSTGRES_PORT=5432

# ---- Django ----
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-in-prod
DJANGO_ALLOWED_HOSTS=*
DJANGO_ANON_THROTTLE=20/min
DJANGO_AUTH_THROTTLE=20/min
DJANGO_LOGIN_THROTTLE=5/min

# ---- JWT ----
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Vodafone Cash ----
# The account customers transfer money to. Not the same as the WhatsApp number.
VODAFONE_CASH_NUMBER=

# ---- AI Provider ----
# Options: mock | ollama | openai (any OpenAI-compatible API)
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
AI_MAX_TOKENS=600
AI_TEMPERATURE=0.4
